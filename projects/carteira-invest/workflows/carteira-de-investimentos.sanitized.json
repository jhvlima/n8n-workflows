    {
      "id": "5d3facf7-4ba6-4144-a3d9-d4f60fbe28d6",
      "name": "Ordena cronologicamente",
      "type": "n8n-nodes-base.sort",
      "typeVersion": 1,
      "position": [
        496,
        1824
      ],
      "parameters": {
        "type": "code",
        "code": "// Os dois itens a serem comparados estão nas variáveis a e b.\n\n// --- Ferramentas Auxiliares ---\n\n// Ferramenta 1: Uma função para \"traduzir\" a data para um formato consistente (YYYY-MM-DD).\n// Isso garante que a comparação cronológica seja correta.\nfunction parseAndFormatDate(dateString) {\n  // Se a data for inválida, retorna um texto de erro para garantir que a comparação falhe.\n  if (typeof dateString !== 'string' || !/^\\d{2}\\/\\d{2}\\/\\d{4}$/.test(dateString)) {\n    return 'DATA_INVALIDA';\n  }\n  const parts = dateString.split('/');\n  const day = parts[0];\n  const month = parts[1];\n  const year = parts[2];\n  return `${year}-${month}-${day}`; // Retorna no formato YYYY-MM-DD\n}\n\n// Ferramenta 2: Uma função para criar a \"impressão digital\" (chave única).\nfunction createUniqueKey(item) {\n  // Pega a data e a traduz para o formato Ano-Mês-Dia.\n  const formattedDate = parseAndFormatDate(item.json.Data);\n  \n  // Pega os outros campos.\n  const produto = item.json.Produto;\n  const movimentacao = item.json.Movimentação;\n  const valor = item.json['Valor da Operação']; // Usamos colchetes por causa do espaço no nome\n\n  // Junta tudo em um único texto, separado por um caractere que não deve aparecer nos dados.\n  return `${formattedDate}|${produto}|${movimentacao}|${valor}`;\n}\n\n// --- Lógica Principal da Comparação ---\n\n// 1. Cria a chave única para o item 'a'.\nconst keyA = createUniqueKey(a);\n\n// 2. Cria a chave única para o item 'b'.\nconst keyB = createUniqueKey(b);\n\n// 3. Compara as duas chaves. Esta é a lógica padrão, mas agora aplicada\n//    à nossa chave customizada, que representa a linha inteira.\nif (keyA < keyB) {\n  return -1; // 'a' é considerado \"menor\" que 'b'.\n}\nif (keyA > keyB) {\n  return 1; // 'a' é considerado \"maior\" que 'b'.\n}\n\n// Se as chaves forem idênticas, significa que os itens são iguais.\nreturn 0;"
      }
    },
