    {
      "id": "20fb0ee6-bf53-4930-a9cc-1b1f21b79e33",
      "name": "Normalizar entrada Telegram",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        64,
        -160
      ],
      "parameters": {
        "jsCode": "const actions = {\n  ct_ver_servicos: 'O usuário clicou em Ver nossos serviços. Apresente de forma breve e comercialmente útil as três áreas da CT Junior: consultoria e gestão, construção civil e tecnologia. Dê exemplos objetivos já autorizados no seu prompt e encerre perguntando qual área se aproxima mais da necessidade dele.'\n};\n\nreturn $input.all().map(item => {\n  const update = item.json;\n  const callback = update.callback_query;\n  const message = update.message || callback?.message || {\n    chat: { id: update.chatId || update.sessionId || 'webchat' }\n  };\n  const callbackAction = callback?.data || '';\n  const chatInput = actions[callbackAction] || update.chatInput || message.text || '';\n  const sessionKey = String(message.chat?.id || update.sessionId || update.chatId || 'anonymous');\n\n  return {\n    json: {\n      ...update,\n      message,\n      chatInput,\n      sessionKey,\n      callbackAction,\n      callbackQueryId: callback?.id || ''\n    },\n    binary: item.binary\n  };\n});"
      }
    },
