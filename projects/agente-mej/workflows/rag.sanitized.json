    {
      "id": "0000fbc5-ecf8-460f-b6c0-bd01ad93038d",
      "name": "Identificar documento Drive",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        200,
        160
      ],
      "parameters": {
        "jsCode": "return $input.all().map(item => ({\n  json: {\n    ...item.json,\n    source_type: 'google_drive_document',\n    source_file: item.binary?.data?.fileName || item.json.name || 'documento_drive',\n    source_url: item.json.webViewLink || ''\n  },\n  binary: item.binary\n}));"
      }
    },
