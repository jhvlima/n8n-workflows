{
  "name": "Bootstrap - Formulário de Documentação n8n",
  "nodes": [
    {
      "id": "1aaa28de-3308-4761-9c5e-a4eb6877850d",
      "name": "Abrir formulário de documentação",
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2.6,
      "position": [
        -900,
        0
      ],
      "webhookId": "3b43de72-32df-47b9-90f9-9373e5c2c282",
      "parameters": {
        "authentication": "n8nUserAuth",
        "formTitle": "Documentar projeto n8n",
        "formDescription": "Carregue os projetos identificados pelas tags docs-internal e project:<slug>.",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Confirmação",
              "fieldName": "confirmLoad",
              "fieldType": "checkbox",
              "fieldOptions": {
                "values": [
                  {
                    "option": "Carregar projetos disponíveis"
                  }
                ]
              },
              "requiredField": true
            }
          ]
        },
        "responseMode": "lastNode",
        "options": {
          "appendAttribution": false,
          "buttonLabel": "Carregar projetos",
          "path": "bootstrap-documentacao",
          "ignoreBots": true,
          "includeUserInOutput": true,
          "useWorkflowTimezone": true
        }
      }
    },
    {
      "id": "0256c89e-9524-48b7-8446-ba348dcc9055",
      "name": "Configuração do formulário",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -660,
        0
      ],
      "parameters": {
        "jsCode": "const input=$input.first()?.json??{};\nreturn [{json:{\n  ...input,\n  requiredTag:'docs-internal',\n  projectTagPrefix:'project:',\n  projectSlug:'',\n  aiMode:'bootstrap',\n  documentationMode:'form-discovery',\n  owner:String(input.owner??'YOUR_GITHUB_USER'),\n  repository:String(input.repository??'YOUR_REPOSITORY'),\n  branch:String(input.branch??'docs/generated')\n}}];"
      }
    },
    {
      "id": "f3ad18ef-d948-4f6d-8973-5c2b24feddb9",
      "name": "Descobrir projetos documentáveis",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.3,
      "position": [
        -420,
        0
      ],
      "parameters": {
        "workflowId": {
          "__rl": true,
          "value": "SELECT_CORE_WORKFLOW_AFTER_IMPORT",
          "mode": "list",
          "cachedResultName": "Core - Documentação n8n (Dry Run)"
        },
        "options": {
          "waitForSubWorkflow": true
        }
      }
    },
    {
      "id": "a27ae2e7-55f5-4856-8775-26cc85f9a488",
      "name": "Preparar projetos para seleção",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -60,
        0
      ],
      "parameters": {
        "jsCode": "const payloads=$('Descobrir projetos documentáveis').first().json.payloads??[];\nconst published=new Set($input.all()\n  .map(item=>item.json??{})\n  .filter(item=>item.type==='dir'&&String(item.path??'').startsWith('projects/'))\n  .map(item=>String(item.name??'').trim().toLowerCase())\n  .filter(Boolean));\nconst projects=payloads\n  .filter(item=>item?.kind==='project'&&item?.projectSlug)\n  .map(item=>({projectSlug:String(item.projectSlug),title:String(item.title??item.projectSlug)}))\n  .filter(item=>!published.has(item.projectSlug.toLowerCase()))\n  .sort((a,b)=>a.projectSlug.localeCompare(b.projectSlug));\nif(projects.length===0) throw new Error('Nenhum projeto novo está disponível. Os projetos encontrados já possuem Bootstrap.');\nreturn [{json:{\n  availableProjects:projects.map(item=>item.projectSlug),\n  formDefinition:[{\n    fieldLabel:'Projeto',\n    fieldName:'projectSlug',\n    fieldType:'dropdown',\n    fieldOptions:{values:projects.map(item=>({option:item.projectSlug}))},\n    requiredField:true\n  }]\n}}];"
      }
    },
    {
      "id": "c9f9060b-a769-40dd-a7cb-f5350ac56ba9",
      "name": "Escolher projeto",
      "type": "n8n-nodes-base.form",
      "typeVersion": 2.5,
      "position": [
        180,
        0
      ],
      "webhookId": "f039b334-34c3-4869-9e15-858f00305d0b",
      "parameters": {
        "operation": "page",
        "defineForm": "json",
        "jsonOutput": "={{ JSON.stringify($json.formDefinition) }}",
        "options": {
          "formTitle": "Escolha o projeto",
          "formDescription": "A documentação inicial será gerada por IA e publicada no GitHub. Projetos já inicializados serão bloqueados.",
          "buttonLabel": "Gerar documentação"
        }
      }
    },
    {
      "id": "b8a75f97-78c0-4b34-87c2-dcb3e88c0643",
      "name": "Validar seleção",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        420,
        0
      ],
      "parameters": {
        "jsCode": "const projectSlug=String($json.projectSlug??'').trim().toLowerCase();\nconst available=$('Preparar projetos para seleção').first().json.availableProjects??[];\nif(!available.includes(projectSlug)) throw new Error('Projeto inválido ou não disponível: '+projectSlug);\nconst cfg=$('Configuração do formulário').first().json;\nreturn [{json:{\n  projectSlug,\n  aiMode:'bootstrap',\n  owner:cfg.owner,\n  repository:cfg.repository,\n  branch:cfg.branch,\n  forceBootstrap:false,\n  documentationMode:'bootstrap'\n}}];"
      }
    },
    {
      "id": "6a3da3d0-9294-4872-a21b-d2934e77b1c4",
      "name": "Executar Bootstrap selecionado",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.3,
      "position": [
        660,
        0
      ],
      "parameters": {
        "workflowId": {
