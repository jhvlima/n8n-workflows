          "value": "SELECT_BOOTSTRAP_WORKFLOW_AFTER_IMPORT",
          "mode": "list",
          "cachedResultName": "Bootstrap - Documentação n8n"
        },
        "options": {
          "waitForSubWorkflow": true
        }
      }
    },
    {
      "id": "defd82c8-80b3-4383-ad47-0cea7b3828c4",
      "name": "Confirmar conclusão",
      "type": "n8n-nodes-base.form",
      "typeVersion": 2.5,
      "position": [
        900,
        0
      ],
      "webhookId": "72458451-9bc6-4eb7-b597-0e2f9e49e3af",
      "parameters": {
        "operation": "completion",
        "respondWith": "text",
        "completionTitle": "Documentação gerada",
        "completionMessage": "={{ 'O Bootstrap do projeto ' + $json.projectSlug + ' foi concluído. Revise a branch ' + $json.branch + ' no GitHub.' }}",
        "options": {
          "formTitle": "Bootstrap concluído"
        }
      }
    },
    {
      "id": "7bb16e62-2e6b-4439-bd51-40a8d87b1a6d",
      "name": "Documentação - Formulário do Bootstrap",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -900,
        -360
      ],
      "parameters": {
        "content": "## Formulário — entrada humana do Bootstrap\n\n- Exige login de usuário do n8n.\n- Descobre projetos dinamicamente pelo Core.\n- Oculta projetos já publicados no GitHub.\n- Aceita somente slugs apresentados no dropdown.\n- Nunca expõe owner, repositório, branch ou forceBootstrap.\n- Chama o Bootstrap como subworkflow e aguarda a publicação.\n- URL: /form/bootstrap-documentacao",
        "height": 280,
        "width": 680,
        "color": 5
      }
    },
    {
      "id": "7004db15-e829-4084-9733-277a0fd9383f",
