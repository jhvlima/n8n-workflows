      "name": "Executar core determinístico"
    },
    {
      "parameters": {
        "jsCode": "const summary = $input.first().json;\nconst owner = \"YOUR_GITHUB_USER\";\nconst repository = \"YOUR_REPOSITORY\";\nconst branch = \"docs/generated\";\nconst slugify = (value) => String(value).normalize(\"NFD\").replace(/[\\u0300-\\u036f]/g, \"\").toLowerCase().replace(/[^a-z0-9]+/g, \"-\").replace(/^-|-$/g, \"\");\nconst output = [];\nfor (const project of summary.payloads ?? []) {\n  const slug = slugify(project.title);\n  for (const [relativePath, desiredContent] of Object.entries(project.files ?? {})) {\n    output.push({ json: {\n      owner, repository, branch, slug,\n      workflowId: project.workflowId,\n      projectTitle: project.title,\n      path: `projects/${slug}/${relativePath}`,\n      desiredContent,\n      commitMessage: `docs(${slug}): sync ${relativePath}`,\n    } });\n  }\n}\nif (output.length === 0) throw new Error(\"O core não retornou arquivos para publicação.\");\nreturn output;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        304,
        0
      ],
      "id": "237a6e2e-3e60-4a38-9e76-1a8f538fa405",
      "name": "Expandir arquivos"
    },
