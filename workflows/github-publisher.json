      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const desired = $(\"Preparar upsert\").item.json;\nreturn { json: {\n  action: desired.existed ? \"updated\" : \"created\",\n  path: desired.path,\n  branch: desired.branch,\n  workflowId: desired.workflowId,\n  projectTitle: desired.projectTitle,\n  commitSha: $json.commit?.sha ?? null,\n} };"
      },
      "type": "n8n-nodes-base.code",
