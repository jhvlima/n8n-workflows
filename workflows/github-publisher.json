{
  "name": "Publisher - GitHub n8n-workflows",
  "nodes": [
    {
      "parameters": {},
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        -176,
        0
      ],
      "id": "8ab0c44d-5ef6-476f-b5c9-c4bc25d2eee2",
      "name": "Testar Publisher manualmente"
    },
    {
      "parameters": {
        "jsCode": "const inputs=$input.all().map(item=>item.json);\n  const output=[];\n  for(const publication of inputs){\n    const owner=String(publication.owner??'').trim();\n    const repository=String(publication.repository??'').trim();\n    const branch=String(publication.branch??'').trim();\n    if(!owner||!repository||!branch) throw new Error('owner, repository e branch são obrigatórios.');\n    const entries=Array.isArray(publication.files)\n      ? publication.files.map(file=>[file.path,file.content])\n      : Object.entries(publication.files??{});\n    for(const [pathValue,contentValue] of entries){\n      const filePath=String(pathValue??'').replace(/^\\/+/, '');\n      if(!filePath.startsWith('projects/')||filePath.split('/').includes('..')){\n        throw new Error('Caminho de publicação inválido: '+filePath);\n      }\n      if(typeof contentValue!=='string') throw new Error('Conteúdo deve ser texto: '+filePath);\n      output.push({json:{\n        owner,repository,branch,\n        projectSlug:publication.projectSlug,\n        path:filePath,\n        desiredContent:contentValue,\n        commitMessage:String(publication.commitMessage??('docs('+publication.projectSlug+'): sync '+filePath))\n      }});\n    }\n  }\n  if(output.length===0) throw new Error('Nenhum arquivo recebido para publicação.');\n  return output;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        80,
        80
      ],
      "id": "237a6e2e-3e60-4a38-9e76-1a8f538fa405",
      "name": "Expandir arquivos"
    },
    {
      "parameters": {
        "resource": "file",
        "operation": "get",
        "owner": {
          "__rl": true,
          "value": "={{ $json.owner }}",
          "mode": "name"
        },
        "repository": {
          "__rl": true,
          "value": "={{ $json.repository }}",
          "mode": "name"
        },
        "filePath": "={{ $json.path }}",
        "asBinaryProperty": false,
        "additionalParameters": {
          "reference": "={{ $json.branch }}"
        }
      },
      "type": "n8n-nodes-base.github",
      "typeVersion": 1.1,
      "position": [
        560,
        96
      ],
      "id": "4363f087-1e8c-4c1e-89eb-ba49d87ced8f",
      "name": "Consultar arquivo existente",
      "webhookId": "7963377b-46f8-41b0-a672-370f88274829",
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const desired=$('Loop por arquivo').item.json;\n  const currentSha=typeof $json.sha==='string'?$json.sha:null;\n  let currentContent=null;\n  if(typeof $json.content==='string'){\n    try{currentContent=Buffer.from($json.content.replace(/\\s/g,''),'base64').toString('utf8');}\n    catch{currentContent=null;}\n  }\n  const changed=currentContent!==desired.desiredContent;\n  const requestBody={\n    message:desired.commitMessage,\n    content:Buffer.from(desired.desiredContent,'utf8').toString('base64'),\n    branch:desired.branch\n  };\n  if(currentSha) requestBody.sha=currentSha;\n  return {json:{...desired,existed:Boolean(currentSha),currentSha,currentContent,changed,requestBody}};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        800,
        96
      ],
      "id": "57dff19b-cbc2-406d-8d0d-f0f00ec108a0",
      "name": "Preparar upsert"
    },
    {
      "parameters": {
        "method": "PUT",
        "url": "={{ `https://api.github.com/repos/${$json.owner}/${$json.repository}/contents/${$json.path.split(\"/\").map(encodeURIComponent).join(\"/\")}` }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "githubApi",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/vnd.github+json"
            },
            {
              "name": "X-GitHub-Api-Version",
              "value": "2022-11-28"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ $json.requestBody }}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [
        1280,
        16
      ],
      "id": "37390114-a6a1-494f-a558-24dce92e03fd",
      "name": "Criar ou atualizar no GitHub"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const desired=$('Preparar upsert').item.json;\n  return {json:{\n    action:desired.existed?'updated':'created',\n    changed:true,\n    path:desired.path,\n    branch:desired.branch,\n    projectSlug:desired.projectSlug,\n    commitSha:$json.commit?.sha??null\n  }};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1520,
        16
      ],
      "id": "be770820-f4da-4657-a1ce-c14ca26bcb03",
      "name": "Registrar arquivo publicado"
    },
    {
      "parameters": {
        "jsCode": "const results=$input.all().map(item=>item.json);\n  const first=results[0]??{};\n  return [{json:{\n    status:'published',\n    repository:first.owner&&first.repository?first.owner+'/'+first.repository:undefined,\n    branch:first.branch,\n    created:results.filter(item=>item.action==='created').length,\n    updated:results.filter(item=>item.action==='updated').length,\n    skipped:results.filter(item=>item.action==='skipped').length,\n    files:results,\n    reviewRequired:true\n  }}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        560,
        -176
      ],
      "id": "704cb3cd-5b6a-46ee-9961-5df7f4a4a324",
      "name": "Resumo da publicação"
    },
    {
      "parameters": {
        "options": {}
      },
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        336,
        80
      ],
      "id": "0c94e316-ad50-45f4-800c-bb1a213f9e3e",
      "name": "Loop por arquivo"
    },
    {
      "parameters": {
        "content": "## Publisher genérico\n\n- Recebe owner, repository, branch e caminhos completos.\n- Aceita somente arquivos dentro de projects/.\n- Compara o conteúdo e ignora arquivos idênticos.\n- Publica serialmente para evitar conflitos.\n- Não chama Core nem IA.\n- Não remove arquivos existentes.",
        "height": 360,
        "width": 660,
        "color": 4
      },
      "id": "7b57ecbb-128d-4234-90f8-cde0596ebb1e",
      "name": "Documentação - Publisher genérico",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -176,
        -480
      ]
    },
    {
