      "position": [
        720,
        16
      ],
      "id": "4363f087-1e8c-4c1e-89eb-ba49d87ced8f",
      "name": "Consultar arquivo existente",
      "webhookId": "7963377b-46f8-41b0-a672-370f88274829",
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const desired = $(\"Loop por arquivo\").item.json;\nconst currentSha = typeof $json.sha === \"string\" ? $json.sha : null;\nconst requestBody = {\n  message: desired.commitMessage,\n  content: Buffer.from(desired.desiredContent, \"utf8\").toString(\"base64\"),\n  branch: desired.branch,\n};\nif (currentSha) requestBody.sha = currentSha;\nreturn { json: { ...desired, existed: Boolean(currentSha), currentSha, requestBody } };"
      },
      "type": "n8n-nodes-base.code",
