            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "76aa3329-9a00-4001-b1cd-7a20070de7d1",
              "operator": {
                "name": "filter.operator.equals",
                "type": "string",
                "operation": "equals"
              },
              "leftValue": "={{ String($json.changed) }}",
              "rightValue": "true"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "c331b3c0-ec6e-4bf3-b62d-8671f984766e",
      "name": "Registrar arquivo sem mudança",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1280,
        192
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "return {json:{\n    action:'skipped',\n    changed:false,\n    path:$json.path,\n    branch:$json.branch,\n    projectSlug:$json.projectSlug,\n    commitSha:$json.currentSha??null\n  }};"
      }
    }
  ],
