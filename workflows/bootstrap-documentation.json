    {
      "id": "b09ffd55-1c18-496f-b98d-19b4a500a772",
      "name": "Preparar publicação inicial",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1920,
        80
      ],
      "parameters": {
        "jsCode": "const cfg=$('Configuração Bootstrap').first().json;\n  const input=$input.first().json;\n  const project=Array.isArray(input.payloads)?input.payloads[0]:input;\n  if(!project?.projectSlug) throw new Error('Projeto ausente na preparação do Bootstrap.');\n  const manifest=JSON.parse(project.technicalFiles?.['project.json']??'{}');\n  const today=new Intl.DateTimeFormat('en-CA',{timeZone:'America/Sao_Paulo',year:'numeric',month:'2-digit',day:'2-digit'})\n    .format(new Date()).replace(/-/g,'.');\n  const updatedManifest={\n    ...manifest,\n    bootstrapCompleted:true,\n    sourceOfTruth:'github',\n    aiMode:cfg.aiMode,\n    currentVersion:today+'.1',\n    bootstrapAt:new Date().toISOString(),\n    reviewRequired:true\n  };\n  const technicalFiles={...(project.technicalFiles??{})};\n  delete technicalFiles['project.json'];\n  const relativeFiles={\n    ...technicalFiles,\n    ...(project.humanFiles??{}),\n    'project.json':JSON.stringify(updatedManifest,null,2)\n  };\n  const files=Object.fromEntries(Object.entries(relativeFiles).map(([file,content])=>[\n    'projects/'+project.projectSlug+'/'+file,content\n  ]));\n  return [{json:{\n    owner:cfg.owner,\n    repository:cfg.repository,\n    branch:cfg.branch,\n    projectSlug:project.projectSlug,\n    files,\n    commitMessage:'docs('+project.projectSlug+'): bootstrap documentation'\n  }}];"
      }
    },
