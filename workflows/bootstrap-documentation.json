      "name": "Configuração Bootstrap",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        80
      ],
      "parameters": {
        "jsCode": "const input=$input.first()?.json??{};\n  return [{json:{\n    projectSlug:String(input.projectSlug??'YOUR_PROJECT_SLUG').trim().toLowerCase(),\n    aiMode:String(input.aiMode??'bootstrap'),\n    owner:String(input.owner??'YOUR_GITHUB_USER'),\n    repository:String(input.repository??'YOUR_REPOSITORY'),\n    branch:String(input.branch??'docs/generated'),\n    forceBootstrap:Boolean(input.forceBootstrap??false),\n    documentationMode:'bootstrap'\n  }}];"
      }
    },
    {
      "id": "85c62e68-971c-42e0-ae89-99cbc112c8a4",
      "name": "Consultar projeto existente",
      "type": "n8n-nodes-base.github",
      "typeVersion": 1.1,
      "position": [
        480,
