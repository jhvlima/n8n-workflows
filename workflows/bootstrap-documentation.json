        "jsCode": "const publication=$input.first().json;\n  const cfg=$('Configuração Bootstrap').first().json;\n  return [{json:{\n    status:'bootstrap-complete',\n    projectSlug:cfg.projectSlug,\n    aiMode:cfg.aiMode,\n    repository:cfg.owner+'/'+cfg.repository,\n    branch:cfg.branch,\n    publication,\n    reviewRequired:true\n  }}];"
