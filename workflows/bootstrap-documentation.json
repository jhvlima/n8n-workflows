          "value": "={{ $(\"Configuração Bootstrap\").first().json.repository }}",
          "mode": "name"
        },
        "filePath": "={{ \"projects/\" + $(\"Configuração Bootstrap\").first().json.projectSlug + \"/project.json\" }}",
        "asBinaryProperty": false,
        "additionalParameters": {
          "reference": "={{ $(\"Configuração Bootstrap\").first().json.branch }}"
        }
      },
      "webhookId": "a0550118-6714-4496-89e6-6ce7e13f8abc"
    },
    {
      "id": "6f3dbc1b-f042-4b77-bf2f-a9abc2edfe40",
      "name": "Validar primeira execução",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        80
      ],
      "parameters": {
        "jsCode": "const cfg=$('Configuração Bootstrap').first().json;\n  const exists=typeof $json.sha==='string';\n  if(exists&&!cfg.forceBootstrap){\n    throw new Error('Bootstrap já concluído para '+cfg.projectSlug+'. Use forceBootstrap somente com revisão explícita.');\n  }\n  return [{json:cfg}];"
      }
    },
    {
      "id": "49ef391e-83f5-4d12-99c4-bb47fee8ff61",
      "name": "Executar Core do projeto",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.1,
      "position": [
        960,
        80
      ],
      "parameters": {
        "workflowId": {
          "__rl": true,
